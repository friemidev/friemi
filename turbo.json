{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "CLERK_SECRET_KEY",
    "ENABLE_WEREWOLF_TEST_BOTS",
    "KV_REST_API_TOKEN",
    "KV_REST_API_READ_ONLY_TOKEN",
    "KV_REST_API_URL",
    "KV_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_ENABLE_WEREWOLF_TEST_BOTS",
    "REDIS_KEY_PREFIX",
    "REDIS_RATE_LIMIT_MODE",
    "REDIS_RATE_LIMIT_TIMEOUT_MS",
    "REDIS_UNREAD_CACHE_MODE",
    "REDIS_UNREAD_CACHE_TTL_SECONDS",
    "REDIS_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_BUCKET",
    "UNREAD_BADGE_FRESHNESS_GUARD_ENABLED",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "VERCEL_ENV"
  ],
  "globalDependencies": ["apps/web/prisma/schema.prisma"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["db:generate", "^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "cache": false
    }
  }
}
